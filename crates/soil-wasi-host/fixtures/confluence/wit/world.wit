// A Confluence webhook handler as a Spore.
//
// The world imports only host capabilities. `wasi:http` comes from the
// `wasip2` runtime crate used by the guest, and the host provides the HTTP
// listener.
package soil:confluence-fixture@0.1.0;

world confluence {
  import fungos:http-context/context@0.1.0;
  import soil:creds/creds@1.0.0;
  import soil:unibus/bus@0.1.0;
}
