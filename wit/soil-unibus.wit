// Bounded observation and publication on the Unibus.
//
// Unibus L1 routes opaque envelopes; this capability is the Spore-facing edge.
// It never exposes credentials, peer identities, or raw sockets. A Spore
// subscribes by kind and receives metadata/body bytes; it does not get bus
// internals or the ability to bypass grants.
package soil:unibus@0.1.0;

interface bus {
  record frame {
    /// Namespaced message kind, e.g. `email.delta.v1` or `chat.message.v1`.
    kind: string,
    /// Producer that published the frame. Not an authorization claim.
    producer: string,
    issued-at-ms: u64,
    /// Opaque body bytes, bounded by the host. The Spore owns the schema.
    body: list<u8>,
  }

  record page {
    frames: list<frame>,
    /// Opaque cursor for the next page, or none at the end.
    next: option<string>,
  }

  record receipt {
    request-id: string,
  }

  enum error {
    /// The observe or publish grant was not linked.
    denied,
    /// Kinds, cursor, body, or TTL is malformed or outside bounds.
    invalid,
    /// The page/body exceeds the host or caller budget.
    over-budget,
    /// The cursor predates the host's retention window.
    stale,
    /// The bus is not reachable.
    unavailable,
  }

  /// Poll retained frames for the listed kinds. An empty `kinds` list means
  /// no kinds, never "all"; a Spore must name what it observes.
  poll: func(kinds: list<string>, cursor: option<string>, limit: u32) -> result<page, error>;

  /// Publish one frame. Requires `soil:unibus.publish`; destinations and TTL
  /// are bounded by the host. No credentials cross this boundary.
  publish: func(
    kind: string,
    body: list<u8>,
    destination: option<string>,
    ttl-ms: u64,
  ) -> result<receipt, error>;
}

world unibus-host {
  import bus;
}
