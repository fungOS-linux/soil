// How a Spore hands over what it rendered.
//
// One package, two arms, because two kinds of guest present the same frame:
//
// * `owner` is the core-Wasm arm. A guest with its own rasterizer (Slint's
//   software renderer, egui, Skia) hands the host consecutive RGBA8 bytes and
//   the host copies them into the frame it presents. The extent stays the
//   host's; the guest never chooses or resizes the display.
// * `surface`/`input`/`cursor`/`clipboard` are the component arm. A
//   `wasm32-wasip2` guest that renders with `wasi:webgpu` hands the host a
//   texture to sample, and receives one ordered input stream and the cursor and
//   clipboard services its window implies.
//
// Bytes rather than a document either way: no scene graph, no JSON, no
// per-frame schema negotiation. A frame is an extent and a buffer.
// How a Spore hands over the pixels it rendered.
//
// Two deliveries, one contract. `rgba` is the encoded arm: the Spore owns the
// rasterizer and the host copies bytes straight into the frame it presents.
// `texture` is the sampled arm: the Spore rendered with `wasi:webgpu` and the
// host samples that texture instead of copying pixels back.
//
// Deliberately not a document format: no scene graph, no JSON, no per-frame
// schema negotiation. A frame is an extent and a buffer.
package soil:present@0.1.0;

interface owner {
  enum failure {
    denied,
    not-ready,
    /// A present budget was exceeded, or the frame did not match the extent.
    over-budget,
    invalid,
    backend,
  }

  enum delivery-kind {
    /// The host samples a texture the Spore rendered.
    texture,
    /// The Spore hands over encoded pixels and the host copies them.
    rgba,
  }

  /// Tightly packed RGBA8, `width * height * 4` bytes, alpha 255.
  ///
  /// The extent is the host's: it equals the surface state the Spore observed,
  /// never a size the Spore chose.
  record rgba-frame {
    width: u32,
    height: u32,
    pixels: list<u8>,
  }

  /// Which arm this host takes. A Spore checks once and picks its renderer.
  delivery: func() -> delivery-kind;

  /// Present an encoded frame. The host validates extent and opacity, then
  /// presents it in the space it granted.
  present-rgba: func(frame: rgba-frame) -> result<_, failure>;
}

// ---------------------------------------------------------------- component arm

/// Presentation-only bridge from a standard `wasi:webgpu` texture to the
/// host compositor. This does not create a second GPU device ABI and does
/// not expose a window or swapchain to the guest.
interface surface {
  use wasi:webgpu/webgpu@0.3.0-rc.2.{gpu-texture};

  /// The surface extent in the Spore's layout space. A Spore lays out against
  /// these numbers and the presenter blits whatever resolution it renders at,
  /// so the same layout matches the window on any display scale.
  size: func() -> tuple<u32, u32>;

  /// Device pixels per layout pixel. A Spore that renders its own texture asks
  /// before it opens a framebuffer, so the frame it presents is at the
  /// resolution the window will actually blit rather than a fixed guess.
  scale: func() -> f64;

  /// Copy one guest-rendered texture into the compositor's next frame.
  present: func(texture: borrow<gpu-texture>) -> result<_, string>;
}


/// Keyboard and pointer events from the presenter. The Spore decides what they
/// mean; the host only normalizes them. Keys and pointer actions share one
/// ordered stream, so a click that lands between two keystrokes cannot be
/// reordered against them.
interface input {
  record key {
    /// Normalized key name: "a", "enter", "escape", "arrow-down", ...
    key: string,
    /// Printable text when the key produced one.
    text: option<string>,
    pressed: bool,
    shift: bool,
    control: bool,
    alt: bool,
    meta: bool,
  }

  enum pointer-button {
    left,
    right,
    middle,
  }

  /// Pointer position in the presenter's surface space: the same units
  /// `soil:present/surface.size` reports, origin top-left. A Spore that lays out
  /// against that size hit-tests with these numbers directly, at any device
  /// pixel ratio, without converting between logical and physical pixels itself.
  record pointer-move {
    x: f32,
    y: f32,
  }

  record pointer-press {
    x: f32,
    y: f32,
    button: pointer-button,
    pressed: bool,
  }

  /// Wheel movement in notches. Positive `lines` scrolls towards earlier
  /// content (the wheel rolled away from the user); a host that only has pixel
  /// deltas converts them to whole notches before queueing.
  record pointer-scroll {
    x: f32,
    y: f32,
    lines: f32,
  }

  variant event {
    key-input(key),
    moved(pointer-move),
    button(pointer-press),
    scrolled(pointer-scroll),
  }

  /// True when a live presenter is attached and the guest should keep polling.
  /// A one-shot capture host returns false and the guest exits after one frame.
  interactive: func() -> bool;

  /// Wait up to `timeout-ms` for the next event. Zero polls without waiting.
  poll: func(timeout-ms: u32) -> option<event>;
}

/// Cursor shape for the window. The Spore says what it is pointing at; the
/// presenter applies it. A headless or capture host reports success and does
/// nothing, so no Spore has to test which host it is running under.
interface cursor {
  enum cursor-style {
    default,
    text,
    pointer,
    crosshair,
    move,
    grab,
    grabbing,
    no-drop,
    wait,
    help,
  }

  set: func(style: cursor-style) -> result<_, string>;
}

/// The system clipboard. A Spore selects text; the presenter owns the
/// pasteboard, so selection stays a Spore concern and the transfer is one call.
interface clipboard {
  set-text: func(text: string) -> result<_, string>;
}

// ---------------------------------------------------------------- worlds

/// A core-Wasm guest that presents encoded pixels.
world runtime-owner {
  import owner;
}

/// A component guest that renders its own texture and reads input.
world component-guest {
  import surface;
  import input;
  import cursor;
  import clipboard;
}
