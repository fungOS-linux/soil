// Host-mediated language-model inference.
//
// The host owns provider selection, endpoint discovery, authentication, model
// aliases, budgets, and transport. A Spore names a model, messages, and tools.
// Credentials and provider routes never cross this boundary.
package soil:inference@0.2.0;

interface inference {
  enum role {
    system,
    user,
    assistant,
    tool,
  }

  record tool-call {
    id: string,
    name: string,
    /// JSON object encoded as a string, exactly as the model emitted it.
    arguments: string,
  }

  record tool {
    name: string,
    description: string,
    /// JSON Schema object encoded as a string.
    parameters: string,
  }

  record attachment {
    name: string,
    mime-type: string,
    data: list<u8>,
    /// Host-extracted text for documents that the provider cannot read directly.
    extracted-text: option<string>,
  }

  record message {
    role: role,
    content: option<string>,
    name: option<string>,
    tool-call-id: option<string>,
    /// Assistant tool calls. Empty for non-assistant messages.
    tool-calls: list<tool-call>,
    /// Image/document attachments. Hosts encode these as provider content parts.
    attachments: list<attachment>,
    /// Optional provider reasoning trace. Hosts may omit it on request.
    reasoning: option<string>,
  }

  record model {
    id: string,
    provider: string,
    context-window: option<u32>,
  }

  record usage {
    prompt-tokens: u32,
    completion-tokens: u32,
    total-tokens: u32,
  }

  record request {
    model: string,
    messages: list<message>,
    tools: list<tool>,
    max-output-tokens: option<u32>,
    temperature: option<f32>,
    /// Opaque provider cache-affinity hint. Hosts may ignore it.
    prompt-cache-key: option<string>,
  }

  record response {
    model: string,
    message: message,
    finish-reason: option<string>,
    usage: option<usage>,
  }

  record chunk {
    /// Raw provider chunk. For OpenAI-compatible SSE this is the event payload.
    data: list<u8>,
    /// True on the final chunk; subsequent `next` calls return `done`.
    done: bool,
  }

  enum error {
    denied,
    not-ready,
    over-budget,
    invalid,
    unavailable,
    auth,
    io,
    unsupported,
  }

  record inference-state {
    ready: bool,
    provider: string,
    model: string,
  }

  /// Streaming response handle. The guest polls it at its own cadence.
  resource completion-stream {
    /// Read the next chunk. `none` means the timeout elapsed without data.
    next: func(timeout-ms: u32) -> result<option<chunk>, error>;
    cancel: func() -> result<_, error>;
  }

  /// List models visible to this host/profile.
  models: func() -> result<list<model>, error>;

  /// Non-streaming completion.
  complete: func(request: request) -> result<response, error>;

  /// Open a streaming completion. The returned resource is bounded by the host
  /// session and must be cancelled or dropped when the guest is done.
  open-stream: func(request: request) -> result<completion-stream, error>;

  state: func() -> result<inference-state, error>;
}

world inference-host {
  import inference;
}

world guest {
  import inference;
}
