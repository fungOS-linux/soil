// Host clocks: elapsed time and wall time.
//
// Requires the `soil:time` grant. There is no sleep, timer thread or per-frame
// callback: a Spore reads a clock and waits on a bounded tick. The host may
// return a tick earlier than requested, so callers must re-check their deadline.
//
// Two clocks, deliberately separate. Monotonic time answers "how long", wall
// time answers "when". Mixing them is how a clock jumps an hour across a
// daylight-saving boundary and a cache silently expires.
package soil:time@1.1.0;

interface time {
  enum error {
    /// The Spore manifest was not granted `soil:time`.
    denied,
    /// The host clock is unavailable. Never fabricate a zero.
    not-ready,
  }

  /// Monotonic milliseconds from an unspecified host epoch.
  ///
  /// Only useful for measuring elapsed time. Values are not comparable across
  /// processes, host restarts or devices.
  monotonic-ms: func() -> result<u64, error>;

  /// One wall-clock instant, already resolved into local components.
  ///
  /// The host owns the timezone: a Spore never converts from UTC, never guesses
  /// an offset, and never reaches for a locale. Components are provided rather
  /// than a formatted string so a view can lay out "14:32" and "Tue 14:32"
  /// without parsing anything, and `offset-minutes` is included so a caller can
  /// label the value without a second call.
  record date-time {
    /// Milliseconds since the Unix epoch (UTC).
    unix-ms: u64,
    /// Minutes east of UTC at this instant, daylight saving included.
    offset-minutes: s32,
    year: u32,
    /// 1-12.
    month: u8,
    /// 1-31.
    day: u8,
    /// 0-23, local.
    hour: u8,
    minute: u8,
    second: u8,
    /// ISO-8601 weekday: 1 = Monday .. 7 = Sunday.
    weekday: u8,
    /// Host zone label such as "PDT", when the platform has one.
    zone: option<string>,
  }

  /// The current wall-clock instant.
  wall-clock: func() -> result<date-time, error>;

  /// Wait up to `timeout-ms` for the next host tick and return its monotonic
  /// millisecond value. `0` polls without blocking; `none` means the deadline
  /// elapsed. A returned tick may precede the requested deadline.
  tick: func(timeout-ms: u32) -> result<option<u64>, error>;
}

world host {
  import time;
}
