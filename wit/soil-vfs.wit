// Read-only VFS namespace.
//
// The Spore names a workspace-relative path, never a host filesystem path,
// directory handle, descriptor, URL or CID supplied as authority. The host
// canonicalizes the path, enforces the workspace boundary, and applies a
// bounded page/range budget. Listing is deterministic by path; sort/search is
// `soil:index`'s job.
//
// `read` returns bytes for an already-present object or hydrates a placeholder
// through the host's granted content transport. The Spore never chooses the
// provider, endpoint, token or lease. A range larger than the host budget is
// `over-budget`, never silently truncated.
package soil:vfs@1.0.0;

interface vfs {
  enum kind {
    file,
    directory,
  }

  enum hydration {
    /// Bytes are present in the workspace or host cache.
    present,
    /// Only the namespace entry and ContentId are present.
    placeholder,
  }

  enum error {
    /// The `soil:vfs` grant was not linked for this Spore.
    denied,
    /// The path does not exist in this workspace.
    not-found,
    /// The caller asked for children of a file.
    not-directory,
    /// The caller asked for bytes from a directory.
    is-directory,
    /// The object is a placeholder and no content transport is available.
    not-hydrated,
    /// The page, range, or object exceeds the host/caller budget.
    over-budget,
    /// The path is not a canonical workspace-relative path.
    invalid,
    /// The host store or content transport failed.
    io,
    /// The namespace changed underneath a paged traversal; restart from offset 0.
    stale,
  }

  record entry {
    /// Canonical workspace-relative path. Empty is the root directory.
    path: string,
    /// Final component; empty for the root.
    name: string,
    kind: kind,
    /// Object size in bytes; 0 for directories.
    size: u64,
    /// Canonical whole-content identity (`blake3:<hex>`), not a provider CID.
    content-id: string,
    media-type: string,
    /// Namespace version, monotonic per path.
    version: u64,
    hydration: hydration,
    pinned: bool,
    updated-at-ms: u64,
    /// Permission bits (`0o755`), not a full `st_mode`. A namespace that can
    /// hold a built binary has to remember that it is executable, or every
    /// materialization hands back a file nobody can run.
    mode: u32,
    /// Direct children for a directory; 0 for a file.
    child-count: u64,
  }

  record page {
    entries: list<entry>,
    /// Offset for the next page, or none when this page is the end.
    next: option<u64>,
  }

  record chunk {
    offset: u64,
    data: list<u8>,
    eof: bool,
    /// Echoes the identity the host actually served.
    content-id: string,
  }

  /// List direct children of `parent` in path order.
  /// `parent` empty means the workspace root. `limit` is host-bounded.
  ls: func(parent: string, offset: u64, limit: u32) -> result<page, error>;

  /// Fetch one namespace entry without reading its bytes.
  stat: func(path: string) -> result<entry, error>;

  /// Read a bounded byte range. `length == 0` is `invalid`.
  /// The host hydrates a placeholder if its transport grant allows it.
  read: func(path: string, offset: u64, length: u32) -> result<chunk, error>;
}
