// Host-attested principal identity.
//
// Mycelium identity / OIDC is the source of truth. The host verifies the
// token or device identity and exposes only this minimal projection. Tokens,
// refresh credentials, raw claims and private keys never cross the boundary.
//
// A principal answers "who". It does not grant access; exact WIT grants and
// book grants still decide what the caller may do and where.
package soil:principal@0.1.0;

interface principal {
  enum kind {
    human,
    agent,
    service,
  }

  enum error {
    denied,
    not-ready,
    stale,
    invalid,
    unavailable,
  }

  record identity {
    /// Stable subject id: OIDC `iss#sub` or a Mycelium principal id.
    actor: string,
    kind: kind,
    /// Presentation only. Never an email address.
    display-name: option<string>,
    /// Host/device identity, stable for this device.
    device: option<string>,
    /// Team/org memberships used by the host to select books.
    teams: list<string>,
    /// Host-mapped roles, not raw OIDC groups.
    roles: list<string>,
    /// Changes on re-auth, team change, role change or device change.
    generation: u64,
  }

  /// Non-secret projection of the key this principal signs with.
  ///
  /// The host owns the key through Geode or an enclave. This record never
  /// carries private material; it is what a verifier or a store needs to name
  /// the signer and resolve its public key.
  record signing-key-info {
    /// Signature algorithm, e.g. `pgp` or `ed25519`.
    algorithm: string,
    /// Public fingerprint, uppercase hex.
    fingerprint: string,
    /// Non-secret Geode address, e.g. `geode://principal/alice/pgp`.
    reference: string,
    /// Changes when the host rotates or replaces the key.
    generation: u64,
  }

  current: func() -> result<identity, error>;

  /// Present only when this principal has a host-managed signing key.
  signing-key: func() -> result<option<signing-key-info>, error>;
}

world guest {
  import principal;
}

world principal-host {
  import principal;
}
