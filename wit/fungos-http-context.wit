// Host-attested context for an incoming HTTP invocation.
//
// The host owns the listener, TLS, and routing. A Spore sees the request only
// through `wasi:http`; this interface adds the host-side facts that must not be
// spoofable request headers: which Spore ran, which route grant matched, and
// who is on the other end of the transport.
//
// `current` is valid only for the duration of one `incoming-handler` call. A
// host that calls a component outside an HTTP invocation has no context to
// report and fails the call rather than inventing one.
package fungos:http-context@0.1.0;

interface context {
  record request-context {
    /// Host-generated request id. Stable for the life of the invocation.
    request-id: string,
    /// Spore name from the host's vhost grant, not from a request header.
    spore: string,
    /// Matched route grant, for example `/webhooks/`.
    route: string,
    /// Remote peer address as the host observed it.
    peer: option<string>,
    /// Verified TLS client identity, when mTLS is in use.
    tls-peer: option<string>,
    /// Host monotonic wall-clock time when the request was accepted.
    received-at-ms: u64,
  }

  current: func() -> request-context;
}

world guest {
  import context;
}

world host {
  import context;
}
