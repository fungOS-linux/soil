// Bounded, explicitly granted VFS mutation.
//
// This is a separate grant from read-only `soil:vfs`. Paths remain canonical
// workspace-relative paths; the Spore never receives a host path, descriptor,
// provider locator, or raw CID.
package soil:vfs-mut@0.1.0;

interface vfs-mut {
  enum error {
    denied,
    not-found,
    already-exists,
    not-directory,
    not-empty,
    conflict,
    over-budget,
    invalid,
    io,
    stale,
  }

  record write-result {
    path: string,
    version: u64,
    content-id: string,
    size: u64,
    /// The entry's permission bits after the write, so a caller can see that a
    /// replace preserved them.
    mode: u32,
  }

  /// Create or replace one file. `expected-version` is the optimistic
  /// concurrency check; `none` means create/replace unconditionally. `mode`
  /// names the permission bits for a caller that has a real file to describe
  /// (the overlay applying a build); `none` keeps the current mode, or `0o644`
  /// for a path that did not exist.
  write: func(
    path: string,
    data: list<u8>,
    media-type: string,
    expected-version: option<u64>,
    mode: option<u32>,
  ) -> result<write-result, error>;

  /// Change permission bits without touching content. A mode belongs to the
  /// entry, not to a version of the bytes, so this adds no version.
  chmod: func(path: string, mode: u32) -> result<write-result, error>;

  /// Unlink a namespace entry. Content and history are retained.
  remove: func(path: string) -> result<_, error>;

  mkdir: func(path: string) -> result<_, error>;
  rmdir: func(path: string) -> result<_, error>;

  /// Rename a file. Directory renames are not part of this slice.
  rename: func(source: string, target: string) -> result<write-result, error>;
}

world host {
  import vfs-mut;
}

world guest {
  import vfs-mut;
}
