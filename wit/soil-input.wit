// Shared normalized input types.
//
// Presentation surfaces (Canvas, Terminal, imported surfaces) use the same
// semantic key, pointer, scroll and text vocabulary. The host owns platform
// keycode and IME translation; guests only see these normalized values.
package soil:input@1.0.0;

interface types {
  /// Host-normalized key. `named` is an escape hatch for imported native
  /// surfaces that expose stable semantic names the host cannot map further.
  variant key {
    up,
    down,
    left,
    right,
    home,
    end,
    page-up,
    page-down,
    insert,
    select,
    back,
    menu,
    info,
    number(u8),
    star,
    hash,
    call,
    end-call,
    push-to-talk,
    soft-left,
    soft-right,
    play-pause,
    rewind,
    fast-forward,
    next,
    previous,
    volume-up,
    volume-down,
    mute,
    f-key(u8),
    character(char),
    backspace,
    delete,
    tab,
    escape,
    enter,
    named(string),
  }

  record modifiers {
    shift: bool,
    control: bool,
    alt: bool,
    meta: bool,
  }

  enum button {
    primary,
    secondary,
    middle,
  }

  /// Normalized surface coordinates, 0..=1.
  record point {
    x: f32,
    y: f32,
  }

  record pointer-button {
    button: button,
    pressed: bool,
    point: point,
  }

  record scroll {
    delta-x: f32,
    delta-y: f32,
    point: point,
  }

  record key-event {
    key: key,
    modifiers: modifiers,
    pressed: bool,
  }

  variant input {
    pointer-move(point),
    pointer-button(pointer-button),
    scroll(scroll),
    key(key-event),
    text(string),
    focus(bool),
  }
}
