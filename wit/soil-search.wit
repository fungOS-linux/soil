// Host-composed global search across granted local sources.
//
// This is a derived discovery surface, not authority. Files still come from
// `soil:vfs`, records from `soil:records`, and actions from their owning host
// capability. A hit is a locator plus display metadata; the caller fetches the
// authoritative object through the source capability.
package soil:search@0.6.0;

interface search {
  enum kind {
    file,
    record-entry,
    repository,
    spore,
    peer,
    service,
    /// An application installed on this host. Host-local by construction: the
    /// inventory differs per machine, is cheap to rebuild, and is never synced.
    application,
    action,
    task,
    principal,
  }

  enum mode {
    substring,
    fuzzy,
    full-text,
    semantic,
    regex,
  }

  enum error {
    denied,
    not-ready,
    over-budget,
    invalid,
    stale,
    io,
    unsupported,
  }

  record query {
    text: string,
    /// Empty means all supported kinds.
    kinds: list<kind>,
    mode: option<mode>,
    offset: u64,
    limit: u32,
  }

  /// A typed graph reference attached to a hit. This is discovery metadata,
  /// not an access grant or a fetched object.
  record reference {
    /// `record`, `repository`, `file`, or an external scheme such as `purl`.
    kind: string,
    id: string,
    /// Relationship label, e.g. `references`, `depends_on`, `works_at`.
    rel: option<string>,
    title: option<string>,
  }

  record hit {
    kind: kind,
    /// Source-local locator: a VFS path, `book/entity`, action id, or bundle id.
    id: string,
    title: string,
    subtitle: option<string>,
    snippet: option<string>,
    /// Higher is more relevant. Stable for one index generation.
    score: u32,
    /// Source identity, e.g. `vfs` or `records:personal/avery/contacts`.
    source: string,
    updated-at-ms: option<u64>,
    /// Bounded graph references attached to this hit. Empty when the host has
    /// no graph index for the object.
    references: list<reference>,
    /// Host-resolved icon, as an asset reference (`asset:sha256:…`). A locator,
    /// not bytes: Canvas resolves it on the render path, and a missing icon is a
    /// named placeholder rather than a hole in a row.
    icon: option<string>,
  }

  record page {
    hits: list<hit>,
    next: option<u64>,
    generation: u64,
  }

  record search-state {
    ready: bool,
    generation: u64,
    sources: u32,
  }

  search: func(query: query) -> result<page, error>;
  state: func() -> result<search-state, error>;
  refresh: func() -> result<search-state, error>;
}


/// Typed mention resolver for `@` autocomplete.
///
/// A candidate is a stable locator, never a copied display name. The caller
/// inserts `token` into a document/task/record and persists it as a
/// `mentions` graph link. The host resolves labels and visibility from the
/// same approved books used by search.
interface mentions {
  use search.{error};

  record candidate {
    /// person, account, company, project, task, opportunity, activity, call,
    /// thread, message, document, sheet, slide, file, or record.
    kind: string,
    /// Stable locator: `record:<book>#<entity>` or `file:<path>`.
    token: string,
    label: string,
    subtitle: option<string>,
    /// Record schema when this candidate came from records.
    schema: option<string>,
    /// File format hint: md, pdf, docx, xlsx, pptx, and so on.
    format: option<string>,
    /// Higher is more relevant. Stable for one host generation.
    score: u32,
    /// team, private, or workspace.
    visibility: string,
  }

  /// Resolve a prefix into typed candidates. Empty `kinds` means all supported
  /// kinds. `limit` is host-bounded.
  suggest: func(
    text: string,
    kinds: list<string>,
    limit: u32,
  ) -> result<list<candidate>, error>;
}

world search-host {
  import search;
  import mentions;
}

world guest {
  import search;
  import mentions;
}
