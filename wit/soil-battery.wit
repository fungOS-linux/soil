package soil:device@0.1.0;

/// Semantic interface. Runtime uses the documented core-Wasm lowering, not
/// component canonical ABI. Tokens are invocation-scoped, single-use handles.
interface battery {
    enum availability { fresh, unknown, stale, denied }
    record snapshot {
        token: u64,
        state: availability,
        percent: option<u8>,
        voltage-microvolts: option<u32>,
    }
    read: func() -> snapshot;
    update-status: func(token: u64);
}
