[submodule "spores-public"]
	path = spores-public
	# https, not ssh. This repository is a dependency of others -- spores itself
	# builds its hosts against a `soil-spore` git pin -- and a git pin checks out
	# submodules. An ssh URL makes every consumer of soil need a GitHub key,
	# which no CI runner has, and that is why the pin in spores sat at a commit
	# from before this submodule existed rather than being bumped.
	url = https://github.com/fungOS-linux/spores.git
