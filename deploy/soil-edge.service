[Unit]
Description=Soil L4 SNI edge (TLS passthrough)
Documentation=https://github.com/mycelium-linux/soil
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=soil-edge
Group=soil-edge
# 127.0.0.1:8443 must be the TLS terminator for the Soil ingress, not the
# plaintext HTTP gateway.
ExecStart=/usr/local/bin/soil-edge \
  --listen 0.0.0.0:443 \
  --route confluence.soil=tcp://127.0.0.1:8443 \
  --alpn confluence/tls/1
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
