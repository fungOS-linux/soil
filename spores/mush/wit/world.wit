// Mush Spore ABI.
//
// The Spore owns shell parsing, environment, cwd, and command semantics. The
// native host owns the VFS/index/mutation grants and calls one command at a
// time. This is the first component slice before the `soil:terminal` surface.
package fungos:mush@0.1.0;

world mush {
  import soil:vfs/vfs@1.0.0;
  import soil:index/index@1.1.0;
  import soil:vfs-mut/vfs-mut@0.1.0;

  record response {
    output: string,
    exit: bool,
    prompt: string,
  }

  /// Initialize the shell and execute the VFS `mushrc` startup file.
  export start: func(args: list<string>) -> result<response, string>;

  /// Execute one command line. State persists between calls.
  export execute: func(line: string) -> result<response, string>;

  /// Current prompt, after mushrc/PS1 expansion.
  export prompt: func() -> string;

  /// Read one shell environment variable.
  export environment: func(name: string) -> option<string>;
}
