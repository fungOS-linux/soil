// Virtual command PATH.
//
// Commands are installed wasm packages, not host binaries. The host resolves a
// name through its command registry and runs the package with explicit args,
// stdin, cwd and a small non-inherited environment.
package soil:command@0.1.0;

interface command {
  record command {
    name: string,
    version: string,
    summary: string,
  }

  record output {
    code: s32,
    stdout: list<u8>,
    stderr: list<u8>,
  }

  /// Installed command packages visible to this Mush profile.
  commands: func() -> list<command>;

  /// Virtual PATH entries. These are names, not host paths.
  path: func() -> list<string>;

  /// Run an installed command. Unknown names fail with a host error.
  run: func(
    name: string,
    args: list<string>,
    stdin: list<u8>,
    cwd: option<string>,
  ) -> result<output, string>;
}

world host {
  import command;
}

world guest {
  import command;
}
