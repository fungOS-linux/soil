// Host-mediated active ringer for calls, doorbells, alarms and pages.
//
// A ring has a real lifecycle and an at-most-one answer claim across devices.
// Notifications are the deferred/missed projection of a ring, not its owner.
package soil:ringer@1.0.0;

interface calls {
  enum kind {
    call,
    doorbell,
    intercom,
    alarm,
    timer,
    pager,
  }

  enum priority {
    passive,
    active,
    urgent,
  }

  enum phase {
    ringing,
    accepted,
    declined,
    ended,
    missed,
  }

  enum error {
    denied,
    not-found,
    not-ringing,
    already-answered,
    over-budget,
    invalid,
    io,
    unavailable,
  }

  record action {
    id: string,
    label: string,
    destructive: bool,
  }

  record ring {
    id: string,
    kind: kind,
    source: string,
    title: string,
    priority: priority,
    expires-at-ms: option<u64>,
    actions: list<action>,
  }

  record state {
    id: string,
    phase: phase,
    answered-by: option<string>,
  }

  resource subscription {
    next: func(timeout-ms: u32) -> result<option<state>, error>;
  }

  incoming: func() -> result<subscription, error>;
  accept: func(id: string) -> result<state, error>;
  decline: func(id: string) -> result<state, error>;
  end: func(id: string) -> result<state, error>;
  mute: func(id: string) -> result<_, error>;
  get-state: func(id: string) -> result<state, error>;
}

world guest {
  import calls;
}
